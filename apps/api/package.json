{
  "name": "@mw/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@mw/contract": "*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "nodemailer": "10.0.13",
    "postgres": "3.4.9",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
