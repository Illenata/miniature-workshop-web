# Copy to .env and adjust. Every setting the server reads is listed here.
# docker compose reads this file too (see docker-compose.yml).

# --- Server -------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Port the API listens on.
PORT=3000
# fatal | error | warn | info | debug | trace. Logs are JSON, without IPs or keys.
LOG_LEVEL=info

# --- Database (any PostgreSQL 15+) ---------------------------------------------
# Local: the postgres service from docker-compose.yml. Inside compose the API
# overrides the host to "postgres" automatically.
POSTGRES_USER=mw
POSTGRES_PASSWORD=mw-local-password
POSTGRES_DB=mw
DATABASE_URL=postgres://mw:mw-local-password@localhost:5432/mw

# --- File storage (any S3-compatible service) ----------------------------------
# Local: the storage service (RustFS) from docker-compose.yml. In production point
# these at your provider (any S3-compatible service).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=miniatures
S3_ACCESS_KEY_ID=mw-local
S3_SECRET_ACCESS_KEY=mw-local-secret
# Self-hosted S3 services need path-style URLs.
S3_FORCE_PATH_STYLE=true
# Create the bucket on startup if missing. Local development only.
S3_CREATE_BUCKET=true

# --- Public URLs ----------------------------------------------------------------
# Origin of the public pages (links to /m/<id> and /c/<id> are built from it).
PUBLIC_BASE_URL=http://localhost:5173
# Origin that serves user files. Must differ from PUBLIC_BASE_URL
# (files.<domain> in production). Locally the API serves them under /files.
FILES_BASE_URL=http://localhost:3000/files

# How the page server reaches the API. Inside docker compose this is set to
# http://api:3000 automatically.
API_INTERNAL_URL=http://localhost:3000

# --- Links (spec appendix C) ----------------------------------------------------
# Leave empty to hide the "Wishlist on Steam" / "Discord" buttons.
STEAM_STORE_URL=
DISCORD_URL=

# --- Privacy and abuse protection ---------------------------------------------
# Secret salt for hashing IP addresses (they are never stored in plain form).
# Set a long random value on a real server, e.g. `openssl rand -hex 32`.
IP_HASH_SALT=local-dev-only-change-me-in-production
# Peers allowed to set X-Forwarded-For (the reverse proxy and the page server):
# loopback and private networks. Never add public addresses here.
TRUST_PROXY=loopback,linklocal,uniquelocal

# --- Admin panel (spec section 7) -----------------------------------------------
# Run `npm run admin:setup`: it asks for a password, shows a QR code for Google
# Authenticator and prints these two values. Empty = the admin panel is switched off.
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# How long a login lasts.
ADMIN_SESSION_HOURS=12

# --- Moderator email (spec section 7) ---------------------------------------------
# Leave SMTP_URL or MODERATOR_EMAIL empty to disable report emails.
# Local: Mailpit from docker-compose.yml, inbox at http://localhost:8025.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Miniature Workshop <noreply@localhost>
MODERATOR_EMAIL=moderator@localhost

# --- Limits (spec appendix C) ---------------------------------------------------
GALLERY_PAGE_SIZE=24
REPORTS_PER_IP_PER_DAY=10
AUTO_HIDE_REPORTS=3
