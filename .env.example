# Copy to .env and adjust. Every setting the server reads is listed here.
# docker compose reads this file too (see docker-compose.yml).

# --- Server -------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Port the API listens on.
PORT=3000
# fatal | error | warn | info | debug | trace. Logs are JSON, without IPs or keys.
LOG_LEVEL=info

# --- Database (any PostgreSQL 15+) ---------------------------------------------
# Local: the postgres service from docker-compose.yml. Inside compose the API
# overrides the host to "postgres" automatically.
POSTGRES_USER=mw
POSTGRES_PASSWORD=mw-local-password
POSTGRES_DB=mw
DATABASE_URL=postgres://mw:mw-local-password@localhost:5432/mw

# --- File storage (any S3-compatible service) ----------------------------------
# Local: MinIO from docker-compose.yml. In production point these at your provider.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=miniatures
S3_ACCESS_KEY_ID=mw-local
S3_SECRET_ACCESS_KEY=mw-local-secret
# MinIO and most self-hosted services need path-style URLs.
S3_FORCE_PATH_STYLE=true
# Create the bucket on startup if missing. Local development only.
S3_CREATE_BUCKET=true

# --- Public URLs ----------------------------------------------------------------
# Origin of the public pages (links to /m/<id> and /c/<id> are built from it).
PUBLIC_BASE_URL=http://localhost:5173
# Origin that serves user files. Must differ from PUBLIC_BASE_URL
# (files.<domain> in production). Locally the API serves them under /files.
FILES_BASE_URL=http://localhost:3000/files

# --- Limits (spec appendix C) ---------------------------------------------------
GALLERY_PAGE_SIZE=24
